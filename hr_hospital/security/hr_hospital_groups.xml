<odoo>
    <data noupdate="1">
        <record id="privilege_hr_hospital" model="res.groups.privilege">
            <field name="name">Hospital management</field>
            <field name="sequence">10</field>
            <field name="description">User access levels for Hr Hospital</field>
        </record>

        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Patients of Hr Hospital</field>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_hr_hospital_patient'))]"/>
            <field name="comment">Interns of Hr Hospital</field>
        </record>

        <record id="group_hr_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[Command.link(ref('hr_hospital.group_hr_hospital_intern'))]"/>
            <field name="comment">Doctors of Hr Hospital</field>
        </record>

        <record id="group_hr_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[Command.link(ref('group_hr_hospital_doctor'))]"/>
            <field name="comment">Managers of Hr Hospital</field>
        </record>

        <record id="group_hr_hospital_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[Command.link(ref('group_hr_hospital_manager'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root', 'base.user_admin'))]"/>
            <field name="comment">Administrators of Hr Hospital (full rights)</field>
        </record>
    </data>
</odoo>