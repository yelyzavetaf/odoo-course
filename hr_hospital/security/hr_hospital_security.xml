<odoo>
    <data noupdate="1">
        <record id="rule_hr_hospital_patient_own_visits" model="ir.rule">
            <field name="name">Patients: Own Visits Only</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_hr_hospital_patient'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_intern_own_visits" model="ir.rule">
            <field name="name">Interns: Own Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_hr_hospital_intern'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_doctor_visits" model="ir.rule">
            <field name="name">Doctors: Own and Interns' Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_hr_hospital_doctor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_manager_all_visits" model="ir.rule">
            <field name="name">Managers: See All Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_hr_hospital_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_hospital_admin" model="ir.rule">
            <field name="name">Admin: Full Access All Models</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_hr_hospital_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
